# 복사해서 .env 로 저장한 뒤 값을 채웁니다. .env 는 커밋하지 않습니다.
AWS_PROFILE=kosa
AWS_REGION=ap-northeast-2
BEDROCK_MOCK=1
TEAM=
# 모델 ID는 코드에 적지 않고 여기서 바꿉니다(모델은 Legacy → 지원 종료로 바뀝니다). 값은 팀 계정에서 호출되는 ID로 채웁니다.
BEDROCK_MODEL_ID=
EMBED_MODEL_ID=

# 로켓펀치 App Key (rp_app_...). 값은 .env 에만 적는다.
ROCKETPUNCH_API_KEY=
# Rocketpunch S3 storage (empty bucket means local-only storage)
ROCKETPUNCH_S3_BUCKET=
ROCKETPUNCH_S3_PREFIX=

# DynamoDB 테이블명. 둘 다 설정하면 fetch·collect 후 추출·수요 집계를 저장합니다.
# 테이블 생성 예시 이름은 skillpath-posting-extractions, skillpath-demand입니다.
DYNAMODB_EXTRACTIONS_TABLE=
DYNAMODB_DEMAND_TABLE=

# 학습 상담 입력 가드레일과 닉네임 프로필 저장소
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
DYNAMODB_PROFILE_TABLE=
SKILLPATH_MOCK_PROFILE_DB=

# Bedrock Guardrails (#24, 상담 에이전트 ai/agent.py 와 ai/guardrail.py). 위 BEDROCK_GUARDRAIL_* 는 ai/chat.py 가 따로 쓴다.
# GUARDRAIL_ID·GUARDRAIL_VERSION 이 비어 있으면 위 BEDROCK_GUARDRAIL_ID·BEDROCK_GUARDRAIL_VERSION 을 씁니다. ID 가 둘 다 없으면 코드 검사만.
# 버전이 둘 다 비어 있으면 DRAFT. GUARDRAIL_OUTPUT=1 이면 답에도 Guardrails 를 적용합니다(기본은 입력만).
# 실제 모드에서 ID 가 있는데 Guardrails 호출이 실패하면(SSO 만료 등) 질문을 막고 "안전 검사를 할 수 없어요" 안내를 보여줍니다.
# 시연 설정(11/19): GUARDRAIL_VERSION=2, GUARDRAIL_TOPIC_BLOCK=1. 버전 2 는 주제 정의에 "전공·비전공 언급은 해당 안 함"을 더한 고정본
GUARDRAIL_ID=
GUARDRAIL_VERSION=2
GUARDRAIL_OUTPUT=0
# 1(기본, 시연 설정)이면 Guardrails 차단 주제로도 막는다. 0 이면 차단 주제는 기록만 하고 프롬프트 공격·혐오·모욕 필터만 막는다.
# 버전 1 을 쓸 때는 0 으로 둔다(버전 1 주제 정의는 "비전공자인데…" 같은 질문을 막는 오탐이 있었다).
GUARDRAIL_TOPIC_BLOCK=1
